# =============================================================================
# TreinaCheck — variáveis de ambiente do front-end
# =============================================================================
# Copie para .env e preencha. O .env NUNCA é versionado (ver .gitignore).
#
#   cp .env.example .env
#
# REGRA DE OURO: tudo que começa com VITE_ é embutido no bundle JavaScript que
# vai para o navegador do usuário. Qualquer pessoa pode ler esses valores
# abrindo o código-fonte da página. Portanto:
#
#   ✅ pode ir aqui   → chave pública (anon / publishable) do Supabase
#   ❌ NUNCA vai aqui → service_role key, segredos de Edge Function, senhas,
#                       chaves de API de terceiros
# =============================================================================

# URL do projeto Supabase (painel → Settings → API → Project URL)
VITE_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"

# Referência do projeto (o trecho antes de .supabase.co)
VITE_SUPABASE_PROJECT_ID="SEU_PROJECT_REF"

# Chave pública. É pública por design — a segurança real vem do Row Level
# Security configurado no banco, não do sigilo desta chave.
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon"


# =============================================================================
# Segredos que NÃO pertencem a este arquivo
# =============================================================================
# Ficam somente no Supabase, definidos com:
#
#   supabase secrets set NOME=valor
#
#   SUPABASE_SERVICE_ROLE_KEY   injetado pela plataforma — bypassa o RLS
#   SUPABASE_ANON_KEY           injetado pela plataforma
#   LOVABLE_API_KEY             weekly-report (Lovable AI Gateway)
#   VAPID_PRIVATE_KEY           send-billing-notifications (Web Push)
#   VAPID_SUBJECT               mailto: de contato do remetente do push
#   CRON_SECRET                 OBRIGATÓRIO para send-billing-notifications.
#                               Protege a função que o pg_cron chama a cada
#                               minuto. Gere com:  openssl rand -hex 32
#                               Sem ele a função responde 500 e nenhum
#                               lembrete de cobrança é enviado.
#
# A chave PÚBLICA do VAPID fica hardcoded em src/lib/push.ts — isso é correto,
# ela é pública por especificação do protocolo Web Push.
# =============================================================================
